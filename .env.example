# Copy this file to `.env` and fill in real values for local development.
# docker-compose automatically reads `.env` for variable substitution.

# ElevenLabs API key used by the FastAPI /narrate-explanation endpoint.
# Get one at https://elevenlabs.io/app/settings/api-keys
# Free tier: 10,000 credits/month. eleven_flash_v2_5 costs 0.5 credits/char,
# so a ~300 char explanation costs ~150 credits (~65 narrations/month free).
# If unset, the narration feature is disabled gracefully (503 from the API).
ELEVENLABS_API_KEY=
